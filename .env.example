DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Shared by Django and the agent. Django never receives the Docker socket.
# Local Django uses loopback. Docker Compose overrides this to http://agent:8001.
AGENT_URL=http://127.0.0.1:8001
AGENT_TOKEN=change-me-too

# OpenAI-compatible chat API. Empty token is fine for a local server.
LLM_API_BASE=http://192.168.0.200:8880/v1
LLM_API_TOKEN=
LLM_MODEL=qwen
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1200
LLM_EFFORT=low

# Used by `createsuperuser --noinput` on first start.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-too
DJANGO_SUPERUSER_EMAIL=admin@localhost
